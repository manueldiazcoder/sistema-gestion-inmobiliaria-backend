# Copia este archivo como .env y rellena tus valores.
#   cp .env.example .env
#
# El archivo .env nunca se versiona: está en el .gitignore.

# Puerto del servidor Express.
PORT=3000

# Secreto con el que se firman y verifican los tokens JWT.
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# URL del servidor Front-end. El backend solo acepta peticiones de este origen (CORS).
FRONT_END_SERVER_URL=http://localhost:4200
